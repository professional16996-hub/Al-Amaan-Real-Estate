# Server & Application Configuration
PORT=3000
APP_URL="http://localhost:3000"

# Authentication & Session Security
# Override in production secrets with a strong 64-byte random hex secret
JWT_SECRET="replace-with-strong-production-jwt-secret"

# Initial Super Admin Account (seeded only on first database initialization; never exposed to client)
INITIAL_ADMIN_EMAIL="admin@alamaan.com"
INITIAL_ADMIN_NAME="Executive Administrator"
INITIAL_ADMIN_PASSWORD="123456"

# Persistent Data & Uploads Directory
DATA_DIR="./data"

# Optional Gemini API Key (injected by runtime environment if configured)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
